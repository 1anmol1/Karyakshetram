# Karyakshetram API (Express + MongoDB)
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/karyakshetram
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=7d
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=300

# ---- ML service (your FastAPI models). Leave empty to use the built-in placeholder engine.
ML_SERVICE_URL=
ML_INTERNAL_KEY=
ML_TIMEOUT_MS=8000
MODEL_VERSION=placeholder-0.1.0

# ---- Optional LLM narrative endpoint (template narratives are used when empty)
LLM_URL=
LLM_API_KEY=
